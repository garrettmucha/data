name: 🔍 Real Container Limits Test
on: [push]

jobs:
  actual-limits:
    runs-on: [self-hosted, ubuntu, custom, rocket-free]
    name: 🎯 Discover Real Container Limits
    steps:
      - name: CPU Limits Test
        run: |
          echo "=== CPU LIMITS TEST ==="
          echo "🖥️ What the host reports:"
          echo "  Total cores: $(nproc)"
          echo "  CPU model: $(grep 'model name' /proc/cpuinfo | head -1 | cut -d: -f2)"
          
          echo ""
          echo "🎯 Testing ACTUAL usable cores:"
          
          # Test with CPU-intensive parallel work
          python3 << 'EOF'
          import threading
          import time
          import multiprocessing
          
          def cpu_burn(duration):
              end_time = time.time() + duration
              count = 0
              while time.time() < end_time:
                  count += 1
              return count
          
          # Test with different thread counts
          for thread_count in [1, 2, 4, 8, 16, 32]:
              print(f"Testing {thread_count} threads...")
              start_time = time.time()
              
              threads = []
              for i in range(thread_count):
                  t = threading.Thread(target=cpu_burn, args=(2,))
                  threads.append(t)
                  t.start()
              
              for t in threads:
                  t.join()
              
              duration = time.time() - start_time
              efficiency = 2.0 / duration * 100
              print(f"  {thread_count} threads: {duration:.2f}s (efficiency: {efficiency:.1f}%)")
              
              # If efficiency drops significantly, we've hit the limit
              if efficiency < 80 and thread_count > 4:
                  print(f"  ⚠️ Performance degraded at {thread_count} threads")
                  break
          EOF

      - name: Memory Limits Test  
        run: |
          echo "=== MEMORY LIMITS TEST ==="
          echo "💾 What the host reports:"
          free -h
          
          echo ""
          echo "🎯 Testing ACTUAL memory limit:"
          
          python3 << 'EOF'
          import sys
          import gc
          
          print("Testing memory allocation in 1GB chunks...")
          allocated = []
          total_mb = 0
          
          try:
              for i in range(20):  # Try up to 20GB
                  # Allocate 1GB (roughly)
                  chunk = bytearray(1024 * 1024 * 1024)  # 1GB
                  allocated.append(chunk)
                  total_mb += 1024
                  print(f"✅ Allocated {total_mb/1024:.1f}GB successfully")
                  
                  # Force garbage collection to see real usage
                  gc.collect()
                  
          except MemoryError:
              print(f"❌ Hit memory limit at ~{total_mb/1024:.1f}GB")
          except Exception as e:
              print(f"❌ Error at {total_mb/1024:.1f}GB: {e}")
          
          print(f"🎯 RESULT: Can allocate ~{total_mb/1024:.1f}GB before hitting limits")
          EOF

      - name: Disk Limits Test
        run: |
          echo "=== DISK LIMITS TEST ==="
          echo "💿 What the host reports:"
          df -h /
          
          echo ""
          echo "🎯 Testing ACTUAL disk write limit:"
          
          # Create large files until we hit limit
          cd /tmp
          total_gb=0
          
          for i in {1..20}; do
            echo "Creating 1GB test file #$i..."
            if dd if=/dev/zero of="test_file_$i.dat" bs=1M count=1024 2>/dev/null; then
              total_gb=$((total_gb + 1))
              echo "✅ Written ${total_gb}GB successfully"
            else
              echo "❌ Hit disk limit at ${total_gb}GB"
              break
            fi
            
            # Check remaining space
            remaining=$(df /tmp | tail -1 | awk '{print $4}')
            remaining_gb=$((remaining / 1024 / 1024))
            echo "   Remaining space: ${remaining_gb}GB"
            
            if [ $remaining_gb -lt 2 ]; then
              echo "⚠️ Less than 2GB remaining, stopping test"
              break
            fi
          done
          
          echo "🎯 RESULT: Can write ~${total_gb}GB before hitting limits"
          
          # Cleanup
          rm -f test_file_*.dat
          echo "🧹 Cleaned up test files"

      - name: Container Resource Discovery
        run: |
          echo "=== CONTAINER RESOURCE DISCOVERY ==="
          
          echo "🔍 Checking cgroups (container limits):"
          
          # Check CPU limits
          if [ -f /sys/fs/cgroup/cpu/cpu.cfs_quota_us ]; then
            quota=$(cat /sys/fs/cgroup/cpu/cpu.cfs_quota_us)
            period=$(cat /sys/fs/cgroup/cpu/cpu.cfs_period_us)
            if [ "$quota" != "-1" ]; then
              cpu_limit=$(echo "scale=2; $quota / $period" | bc -l 2>/dev/null || echo "N/A")
              echo "  CPU limit (cgroups v1): ${cpu_limit} cores"
            else
              echo "  CPU limit (cgroups v1): unlimited"
            fi
          fi
          
          # Check memory limits  
          if [ -f /sys/fs/cgroup/memory/memory.limit_in_bytes ]; then
            mem_limit=$(cat /sys/fs/cgroup/memory/memory.limit_in_bytes)
            if [ "$mem_limit" != "9223372036854775807" ]; then
              mem_gb=$(echo "scale=1; $mem_limit / 1024 / 1024 / 1024" | bc -l 2>/dev/null || echo "N/A")
              echo "  Memory limit (cgroups v1): ${mem_gb}GB"
            else
              echo "  Memory limit (cgroups v1): unlimited"
            fi
          fi
          
          # Check cgroups v2 (newer systems)
          if [ -f /sys/fs/cgroup/cpu.max ]; then
            cpu_max=$(cat /sys/fs/cgroup/cpu.max)
            echo "  CPU limit (cgroups v2): $cpu_max"
          fi
          
          if [ -f /sys/fs/cgroup/memory.max ]; then
            mem_max=$(cat /sys/fs/cgroup/memory.max)
            if [ "$mem_max" != "max" ]; then
              mem_gb=$(echo "scale=1; $mem_max / 1024 / 1024 / 1024" | bc -l 2>/dev/null || echo "N/A")
              echo "  Memory limit (cgroups v2): ${mem_gb}GB"
            else
              echo "  Memory limit (cgroups v2): unlimited"
            fi
          fi
          
          echo ""
          echo "🎯 SUMMARY OF ACTUAL LIMITS:"
          echo "  Based on stress testing above ⬆️"
          echo "  This reveals your TRUE container resources!"

      - name: Performance Reality Check
        run: |
          echo "=== PERFORMANCE REALITY CHECK ==="
          
          echo "🤔 Host specs vs Container reality:"
          echo ""
          echo "HOST HARDWARE:"
          echo "  CPU: $(grep 'model name' /proc/cpuinfo | head -1 | cut -d: -f2)"
          echo "  Cores reported: $(nproc)"
          echo "  Memory reported: $(free -h | grep Mem | awk '{print $2}')"
          echo "  Disk reported: $(df -h / | tail -1 | awk '{print $2}')"
          echo ""
          echo "YOUR CONTAINER LIMITS:"
          echo "  🔬 See stress test results above"
          echo "  🎯 This is what you can actually use!"
          echo ""
          echo "💡 The host hardware is shared among ALL containers"
          echo "💡 Your container gets a SLICE of the total resources"
